---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/paths";

export function getStaticPaths() {
  return Object.values(import.meta.glob<any>("../../content/blog/*.md", { eager: true })).map((post) => ({
    params: { slug: post.file.split("/").pop().replace(/\.md$/, "") },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content, frontmatter } = post;
---
<Base title={frontmatter.title}>
  <article class="post">
    <time datetime={frontmatter.date}>{new Date(frontmatter.date).toLocaleDateString("en-US", { dateStyle: "long" })}</time>
    <h1>{frontmatter.title}</h1>
    {frontmatter.cover && <img src={withBase(frontmatter.cover)} alt="" />}
    <Content />
    <p><a href={withBase("/blog")}>← All posts</a></p>
  </article>
</Base>
