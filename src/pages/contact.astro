---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
import { withBase } from "../lib/paths";
const { contact } = site;
// Empty formAction = Netlify Forms. Otherwise paste a Formspree/Basin/etc. endpoint URL.
const useNetlify = !contact.formAction;
---
<Base title="CONTACT">
  <section class="contact">
    <div>
      <h1>{contact.heading}</h1>
      <address>
        {contact.addressLines.map((l) => <>{l}<br /></>)}
      </address>
      <img class="contact-logo" src={withBase(contact.logo)} alt={site.name} />
    </div>
    <form
      name="contact"
      method="POST"
      action={contact.formAction || `${withBase("/contact")}?sent=1`}
      data-netlify={useNetlify ? "true" : undefined}
      netlify-honeypot={useNetlify ? "bot-field" : undefined}
    >
      <input type="hidden" name="form-name" value="contact" />
      <p hidden><label>Leave empty <input name="bot-field" /></label></p>
      <input name="name" placeholder="Name *" aria-label="Name *" required />
      <input name="email" type="email" placeholder="Email *" aria-label="Email *" required />
      <input name="subject" placeholder="Subject" aria-label="Subject" />
      <textarea name="message" rows="6" placeholder="Message" aria-label="Message"></textarea>
      <button type="submit">{contact.button}</button>
      <p class="sent" hidden>{contact.success}</p>
    </form>
  </section>
  <script>
    if (new URLSearchParams(location.search).has("sent")) {
      document.querySelector<HTMLElement>(".sent")!.hidden = false;
    }
  </script>
</Base>
